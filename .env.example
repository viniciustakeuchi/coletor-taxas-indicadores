# Copie para .env e ajuste. Nunca faça commit do .env.
DATABASE_URL=postgresql+asyncpg://coletor:coletor@localhost:5432/coletor

# Resiliência: tentativas por fonte e backoff exponencial com jitter (segundos)
TENTATIVAS=4
BACKOFF_INICIAL_SEGUNDOS=2
BACKOFF_MAXIMO_SEGUNDOS=30
TIMEOUT_SEGUNDOS=30

# Agendamento (sintaxe crontab; use nomes de dia, como mon-fri)
AGENDA_CRON=0 19 * * mon-fri
FUSO_HORARIO=America/Sao_Paulo

# json para produção, texto para desenvolvimento
LOG_FORMATO=json
LOG_NIVEL=INFO
